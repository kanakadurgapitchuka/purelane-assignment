<section class="purelane-hero" id="top">
  <div class="purelane-hero__inner">

    <div class="purelane-hero__badges">
      <div class="purelane-badge">
        <span class="purelane-badge__icon">🌿</span>
        <span>Plant<br>powered</span>
      </div>

      <div class="purelane-badge">
        <span class="purelane-badge__icon">🛡️</span>
        <span>Safe for<br>kids & pets</span>
      </div>

      <div class="purelane-badge">
        <span class="purelane-badge__icon">◯</span>
        <span>Zero harsh<br>chemicals</span>
      </div>
    </div>

    <div class="purelane-hero__copy">
      <p class="purelane-eyebrow">PURE CLEANING. SIMPLY.</p>

      <h1>
        Tough on grime.<br>
        Gentle on everything else.
